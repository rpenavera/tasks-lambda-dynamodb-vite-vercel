# Variables de entorno del proyecto (plantilla). Copia los valores que necesites; nunca commitees los reales.
# Frontend (Vercel y .env.local en desarrollo)
VITE_API_URL=

# Terraform (alternativa a terraform.tfvars; exporta las que quieras sobrescribir)
TF_VAR_aws_region=us-east-2
TF_VAR_project_name=tasks-1-5-50
TF_VAR_environment=dev
TF_VAR_cors_allow_origins='["http://localhost:5173"]'
